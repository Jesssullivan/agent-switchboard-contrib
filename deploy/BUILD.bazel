load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

package(default_visibility = ["//visibility:public"])

_linux_amd64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

# The swb binary as an image layer.
pkg_tar(
    name = "swb_layer",
    srcs = ["//crates/swb:swb"],
    mode = "0755",
    package_dir = "/usr/local/bin",
    target_compatible_with = _linux_amd64,
)

# SWB-R04: a pinned Linux/amd64 runtime. The nonroot base runs as UID 65532;
# blahaj owns the PVC's writable directory and the exact tailnet Host gate.
oci_image(
    name = "image",
    base = "@distroless_cc_amd64_linux_amd64",
    entrypoint = ["/usr/local/bin/swb"],
    cmd = ["serve"],
    tars = [":swb_layer"],
    target_compatible_with = _linux_amd64,
)

# SWB-R04, R-N13: explicit digest-only publication. `oci_push` uploads by
# digest without a mutable tag; the matching :image.digest is the blahaj input.
# Run only from a reviewed main commit, never as part of PR CI.
oci_push(
    name = "push",
    image = ":image",
    repository = "ghcr.io/xoxd-ai/agent-switchboard",
    target_compatible_with = _linux_amd64,
)
