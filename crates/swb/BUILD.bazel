load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "swb",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    edition = crate_edition(),
    # R-C268: link without debug info. libsqlite3-sys compiles SQLite through
    # the cc crate with -g, and gcc records the build script's sandbox
    # directory (output-base hash plus sandbox counter) as DW_AT_comp_dir.
    # rules_rust does not remap that C path, so it made the image digest
    # depend on the workspace path and sandbox number. Stripping debug info
    # at link time removes it; the build-id then covers identical bytes.
    # This is a BUILD attribute, not .bazelrc, because CI ignores rc files.
    rustc_flags = ["-Cstrip=debuginfo"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/swb-agentd:swb_agentd",
        "//crates/swb-broker:swb_broker",
        "//crates/swb-proto:swb_proto",
        "//crates/swb-store:swb_store",
    ],
)

rust_test(
    name = "swb_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":swb",
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

# R-C262: `swb` with the `test-clock` feature. Only `SWB_TEST_CLOCK=1` on
# loopback listeners switches it to the manual clock. testonly, and not in
# //:build or //deploy:image; the released binary is :swb above.
rust_binary(
    name = "swb_test_clock",
    testonly = True,
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_features = ["test-clock"],
    crate_name = "swb",
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/swb-agentd:swb_agentd",
        "//crates/swb-broker:swb_broker_test_clock",
        "//crates/swb-proto:swb_proto",
        "//crates/swb-store:swb_store",
    ],
)
