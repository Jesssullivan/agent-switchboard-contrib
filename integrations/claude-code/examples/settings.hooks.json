{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "swb hook claude SessionStart 2>/dev/null; exit 0",
            "timeout": 4
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "swb hook claude UserPromptSubmit 2>/dev/null; exit 0",
            "timeout": 4
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "swb hook claude Stop 2>/dev/null; exit 0",
            "timeout": 4
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "swb hook claude SessionEnd 2>/dev/null; exit 0",
            "timeout": 4
          }
        ]
      }
    ]
  }
}
